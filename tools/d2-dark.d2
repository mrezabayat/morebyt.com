      B2: "#8DB6E6"
      B3: "#263442"
      B4: "#141D27"
      B5: "#141D27"
      B6: "#141D27"
      AA2: "#8DB6E6"
      AA4: "#141D27"
      AA5: "#141D27"
      AB4: "#141D27"
      AB5: "#141D27"
    }
